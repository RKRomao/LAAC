<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - LAAC</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-mortarboard-fill me-2"></i>LAAC
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house-fill me-1"></i> Início
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/faq">
                            <i class="bi bi-question-circle-fill me-1"></i> FAQ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/events">
                            <i class="bi bi-calendar-event-fill me-1"></i> Eventos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/support">
                            <i class="bi bi-headset me-1"></i> Suporte
                        </a>
                    </li>
                </ul>
                
                <ul class="navbar-nav">
                    <% if (user) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i> <%= user.name %>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/profile">
                                    <i class="bi bi-person me-2"></i> Perfil
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="#" onclick="logout()">
                                    <i class="bi bi-box-arrow-right me-2"></i> Sair
                                </a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">
                                <i class="bi bi-person-plus me-1"></i> Registar
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-4">
        <% if (typeof messages !== 'undefined' && messages.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <%= messages.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        
        <% if (typeof messages !== 'undefined' && messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <%= messages.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- Carrossel de Notícias -->
        <section class="news-carousel mb-5">
            <div id="newsCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#newsCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#newsCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#newsCarousel" data-bs-slide-to="2"></button>
                    <button type="button" data-bs-target="#newsCarousel" data-bs-slide-to="3"></button>
                    <button type="button" data-bs-target="#newsCarousel" data-bs-slide-to="4"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="/images/2022-07-14-20-23-26-74910.png" class="d-block w-100" alt="Inscrições Abertas">
                        <div class="carousel-caption">
                            <h3>Inscrições Abertas 2024</h3>
                            <p>Junte-se à comunidade LAAC e faça parte da mudança na UBI.</p>
                            <a href="/register" class="btn btn-primary">Inscreva-se Agora</a>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/23043134-1.webp" class="d-block w-100" alt="Sessão de Boas-vindas">
                        <div class="carousel-caption">
                            <h3>Sessão de Boas-vindas</h3>
                            <p>Participe na nossa sessão de acolhimento aos novos caloiros.</p>
                            <a href="/events" class="btn btn-success">Saiba Mais</a>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/template.png" class="d-block w-100" alt="Apoio Emergência">
                        <div class="carousel-caption">
                            <h3>Apoio de Emergência 24/7</h3>
                            <p>Estamos sempre disponíveis para ajudar em situações de emergência.</p>
                            <button class="btn btn-danger" onclick="handleEmergency()">Emergência</button>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <video class="d-block w-100" autoplay muted loop>
                            <source src="/images/video/covi.mp4" type="video/mp4">
                            O seu navegador não suporta a tag de vídeo.
                        </video>
                        <div class="carousel-caption">
                            <h3>Faça Parte da LAAC</h3>
                            <p>Descubra como pode contribuir para a nossa comunidade acadêmica.</p>
                            <a href="/about" class="btn btn-info">Conheça-nos</a>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="/images/iconfundo.png" class="d-block w-100" alt="Experiências LAAC">
                        <div class="carousel-caption">
                            <h3>Experiências Maravilhosas</h3>
                            <p>Viva momentos únicos na UBI com a LAAC.</p>
                            <a href="/events" class="btn btn-warning">Ver Eventos</a>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#newsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#newsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </section>

        <!-- Botão de Emergência -->
        <section class="emergency-section mb-5">
            <div class="container text-center">
                <div class="emergency-card bg-danger text-white p-5 rounded-3 shadow-lg">
                    <div class="emergency-icon mb-4">
                        <i class="bi bi-telephone-fill" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="mb-3">Linha de Emergência LAAC</h2>
                    <p class="lead mb-4">
                        Suporte imediato 24/7 para situações de emergência
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <button class="btn btn-light btn-lg emergency-btn" onclick="handleEmergency()">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Chamada de Emergência
                        </button>
                        <a href="tel:+351912345678" class="btn btn-outline-light btn-lg">
                            <i class="bi bi-telephone-fill me-2"></i>
                            +351 912 345 678
                        </a>
                    </div>
                    <div class="mt-3">
                        <small class="text-light">
                            <i class="bi bi-clock-fill me-1"></i>
                            Disponível 24 horas por dia, 7 dias por semana
                        </small>
                    </div>
                </div>
            </div>
        </section>

        <!-- Mapa Interativo -->
        <section class="map-section mb-5">
            <div class="container">
                <h2 class="text-center mb-5">
                    <i class="bi bi-geo-alt-fill me-2"></i>
                    Mapa de Locais Importantes
                </h2>
                <div class="row">
                    <div class="col-lg-8 mb-4">
                        <div class="map-container rounded-3 shadow-lg overflow-hidden">
                            <iframe 
                                src="https://www.openstreetmap.org/export/embed.html?bbox=-7.506%2C40.276%2C-7.486%2C40.296&layer=mapnik&marker=40.286%2C-7.496" 
                                width="100%" 
                                height="400" 
                                frameborder="0" 
                                style="border:0"
                                allowfullscreen>
                            </iframe>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card shadow-sm">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="bi bi-pin-map-fill me-2"></i>
                                    Locais Rápidos
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="list-group list-group-flush">
                                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="bi bi-building-fill text-primary me-2"></i>
                                            Campus UBI
                                        </div>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="bi bi-hospital-fill text-danger me-2"></i>
                                            Hospital
                                        </div>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="bi bi-shop-fill text-success me-2"></i>
                                            Supermercado
                                        </div>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="bi bi-bus-front-fill text-warning me-2"></i>
                                            Terminal Rodoviário
                                        </div>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="bi bi-bank-fill text-info me-2"></i>
                                            Biblioteca
                                        </div>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                                <div class="mt-3">
                                    <a href="/locations" class="btn btn-primary w-100">
                                        <i class="bi bi-map-fill me-2"></i>
                                        Ver Mapa Completo
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Serviços Restantes -->
        <section class="services-section mb-5">
            <h2 class="text-center mb-5">
                <i class="bi bi-gear-fill me-2"></i>
                Outros Serviços
            </h2>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-body text-center">
                            <div class="feature-icon bg-primary text-white rounded-circle mx-auto mb-3">
                                <i class="bi bi-question-circle-fill fs-3"></i>
                            </div>
                            <h5 class="card-title">FAQ</h5>
                            <p class="card-text">
                                Respostas para as perguntas mais frequentes sobre a vida académica e a cidade.
                            </p>
                            <a href="/faq" class="btn btn-primary">
                                <i class="bi bi-arrow-right me-1"></i>Explorar
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-body text-center">
                            <div class="feature-icon bg-success text-white rounded-circle mx-auto mb-3">
                                <i class="bi bi-calendar-event-fill fs-3"></i>
                            </div>
                            <h5 class="card-title">Eventos</h5>
                            <p class="card-text">
                                Fique por dentro dos eventos académicos e sociais na Universidade da Covilhã.
                            </p>
                            <a href="/events" class="btn btn-success">
                                <i class="bi bi-arrow-right me-1"></i>Ver Eventos
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-body text-center">
                            <div class="feature-icon bg-warning text-white rounded-circle mx-auto mb-3">
                                <i class="bi bi-headset fs-3"></i>
                            </div>
                            <h5 class="card-title">Suporte</h5>
                            <p class="card-text">
                                Suporte personalizado para resolver as suas dúvidas e dificuldades.
                            </p>
                            <a href="/support" class="btn btn-warning">
                                <i class="bi bi-arrow-right me-1"></i>Pedir Ajuda
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-body text-center">
                            <div class="feature-icon bg-info text-white rounded-circle mx-auto mb-3">
                                <i class="bi bi-geo-alt-fill fs-3"></i>
                            </div>
                            <h5 class="card-title">Localizações</h5>
                            <p class="card-text">
                                Encontre facilmente locais importantes na cidade e no campus.
                            </p>
                            <a href="/locations" class="btn btn-info">
                                <i class="bi bi-arrow-right me-1"></i>Mapa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Statistics Section -->
        <section class="stats-section bg-light py-5 mb-5 rounded-3">
            <div class="container">
                <h2 class="text-center mb-5">
                    <i class="bi bi-graph-up me-2"></i>
                    Números que Fazem a Diferença
                </h2>
                <div class="row text-center">
                    <div class="col-md-3 mb-3">
                        <div class="stat-item">
                            <div class="stat-number text-primary fw-bold">500+</div>
                            <div class="stat-label">Alunos Apoiados</div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="stat-item">
                            <div class="stat-number text-success fw-bold">50+</div>
                            <div class="stat-label">Eventos Organizados</div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="stat-item">
                            <div class="stat-number text-warning fw-bold">100+</div>
                            <div class="stat-label">FAQs Resolvidas</div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="stat-item">
                            <div class="stat-number text-info fw-bold">24/7</div>
                            <div class="stat-label">Suporte Disponível</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Recent Updates Section -->
        <section class="updates-section mb-5">
            <h2 class="text-center mb-5">
                <i class="bi bi-bell-fill me-2"></i>
                Últimas Atualizações
            </h2>
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="badge bg-primary me-3">
                                    <i class="bi bi-calendar-event-fill me-1"></i>Evento
                                </div>
                                <small class="text-muted">Há 2 dias</small>
                            </div>
                            <h5 class="card-title">Sessão de Boas-vindas</h5>
                            <p class="card-text">
                                Junte-se a nós para a sessão de boas-vindas aos novos alunos. 
                                Vamos partilhar dicas importantes sobre a vida académica.
                            </p>
                            <a href="/events" class="btn btn-sm btn-primary">Saber mais</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="badge bg-success me-3">
                                    <i class="bi bi-question-circle-fill me-1"></i>FAQ
                                </div>
                                <small class="text-muted">Há 5 dias</small>
                            </div>
                            <h5 class="card-title">Novas FAQs Adicionadas</h5>
                            <p class="card-text">
                                Adicionámos novas perguntas e respostas sobre alojamento, 
                                transporte e serviços na cidade da Covilhã.
                            </p>
                            <a href="/faq" class="btn btn-sm btn-success">Ver FAQs</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section bg-gradient-primary text-white py-5 rounded-3">
            <div class="container text-center">
                <h2 class="mb-4">
                    <i class="bi bi-people-fill me-2"></i>
                    Junte-se à Comunidade LAAC
                </h2>
                <p class="lead mb-4">
                    Faça parte da nossa comunidade e ajude-nos a criar um ambiente 
                    acolhedor para todos os novos alunos.
                </p>
                <% if (!user) { %>
                    <a href="/register" class="btn btn-light btn-lg">
                        <i class="bi bi-person-plus me-2"></i>Registar-se Agora
                    </a>
                <% } else { %>
                    <a href="/support" class="btn btn-light btn-lg">
                        <i class="bi bi-headset me-2"></i>Pedir Suporte
                    </a>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="bi bi-mortarboard-fill me-2"></i>LAAC</h5>
                    <p class="text-muted">Liga de Apoio ao Académico da Covilhã</p>
                    <p class="small">Ajudando novos alunos a integrar-se na vida académica e na cidade da Covilhã.</p>
                </div>
                <div class="col-md-4">
                    <h5>Links Úteis</h5>
                    <ul class="list-unstyled">
                        <li><a href="/faq" class="text-muted text-decoration-none">FAQ</a></li>
                        <li><a href="/events" class="text-muted text-decoration-none">Eventos</a></li>
                        <li><a href="/support" class="text-muted text-decoration-none">Suporte</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Contacto</h5>
                    <p class="text-muted">
                        <i class="bi bi-envelope me-2"></i>contacto@laac.pt<br>
                        <i class="bi bi-telephone me-2"></i>+351 123 456 789
                    </p>
                </div>
            </div>
            <hr class="bg-secondary">
            <div class="text-center">
                <p class="small mb-0">&copy; 2024 LAAC - Liga de Apoio ao Académico da Covilhã. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/main.js"></script>
    
    <style>
        .carousel-item img,
        .carousel-item video {
            height: 400px;
            object-fit: cover;
        }
        
        .carousel-caption {
            background: rgba(0, 0, 0, 0.7);
            padding: 20px;
            border-radius: 10px;
        }
        
        .emergency-card {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            border: none;
            transition: transform 0.3s ease;
        }
        
        .emergency-card:hover {
            transform: translateY(-5px);
        }
        
        .emergency-btn {
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        
        .map-container iframe {
            min-height: 400px;
        }
        
        .hover-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
        
        .feature-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
        }
        
        .stat-label {
            font-size: 1.1rem;
            color: #6c757d;
        }
    </style>
    
    <script>
        function handleEmergency() {
            const confirmed = confirm('Tem certeza que precisa de ajuda de emergência? Iremos conectá-lo imediatamente com um membro da nossa equipe.');
            if (confirmed) {
                window.location.href = 'tel:+351912345678';
                // Também poderia abrir um chat de emergência ou fazer uma chamada automática
                console.log('Chamada de emergência iniciada');
            }
        }
    </script>
</body>
</html>
