<%- include('../layouts/main') %>

<% contentFor('body') { %>
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-mortarboard-fill text-primary fs-1"></i>
                    <h3 class="mt-3">Criar Conta</h3>
                    <p class="text-muted">Junte-se à comunidade LAAC</p>
                </div>

                <form id="registerForm" class="needs-validation" novalidate>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">
                                <i class="bi bi-person me-1"></i>Nome Completo
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" class="form-control" id="name" name="name" 
                                       placeholder="João Silva" required>
                                <div class="invalid-feedback">
                                    Por favor, insira o seu nome completo.
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label">
                                <i class="bi bi-envelope me-1"></i>Email
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" class="form-control" id="email" name="email" 
                                       placeholder="seu.email@exemplo.com" required>
                                <div class="invalid-feedback">
                                    Por favor, insira um email válido.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="password" class="form-label">
                                <i class="bi bi-lock me-1"></i>Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" class="form-control" id="password" name="password" 
                                       placeholder="Mínimo 6 caracteres" required minlength="6">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password')">
                                    <i class="bi bi-eye" id="passwordToggle"></i>
                                </button>
                                <div class="invalid-feedback">
                                    A password deve ter pelo menos 6 caracteres.
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="confirmPassword" class="form-label">
                                <i class="bi bi-lock-fill me-1"></i>Confirmar Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" 
                                       placeholder="Confirme a password" required>
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword')">
                                    <i class="bi bi-eye" id="confirmPasswordToggle"></i>
                                </button>
                                <div class="invalid-feedback">
                                    Por favor, confirme a sua password.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="role" class="form-label">
                            <i class="bi bi-person-badge me-1"></i>Tipo de Utilizador
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person-badge"></i>
                            </span>
                            <select class="form-select" id="role" name="role">
                                <option value="student" selected>Estudante</option>
                                <option value="praxante">Praxante</option>
                                <option value="core_team">Membro da Equipa</option>
                            </select>
                        </div>
                        <small class="text-muted">
                            Selecione o tipo de utilizizador que melhor descreve a sua situação.
                        </small>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="terms" required>
                            <label class="form-check-label" for="terms">
                                Aceito os <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">termos de serviço</a> 
                                e a <a href="#" data-bs-toggle="modal" data-bs-target="#privacyModal">política de privacidade</a>
                            </label>
                            <div class="invalid-feedback">
                                É necessário aceitar os termos de serviço.
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="newsletter">
                            <label class="form-check-label" for="newsletter">
                                Deseja receber novidades e eventos por email?
                            </label>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-person-plus me-2"></i>Criar Conta
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="mb-0">Já tem conta?</p>
                    <a href="/login" class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                    </a>
                </div>
            </div>
        </div>

        <!-- Social Register -->
        <div class="card shadow-lg mt-4">
            <div class="card-body p-4">
                <h6 class="text-center mb-4">Ou registe-se com:</h6>
                <div class="d-grid gap-2">
                    <a href="/api/auth/google" class="btn btn-outline-danger">
                        <i class="bi bi-google me-2"></i>Google
                    </a>
                    <a href="/api/auth/microsoft" class="btn btn-outline-primary">
                        <i class="bi bi-microsoft me-2"></i>Microsoft
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Terms Modal -->
<div class="modal fade" id="termsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Termos de Serviço</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6>1. Aceitação dos Termos</h6>
                <p>Ao criar uma conta na plataforma LAAC, você concorda com estes termos de serviço.</p>
                
                <h6>2. Uso da Plataforma</h6>
                <p>A plataforma LAAC destina-se a apoiar novos alunos na sua integração académica e social.</p>
                
                <h6>3. Responsabilidades do Utilizador</h6>
                <p>Os utilizadores devem manter a precisão das suas informações e comportar-se de forma respeitosa.</p>
                
                <h6>4. Privacidade e Dados</h6>
                <p>Os seus dados pessoais serão tratados de acordo com a nossa política de privacidade.</p>
                
                <h6>5. Modificações</h6>
                <p>Reservamo-nos o direito de modificar estes termos a qualquer momento.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<!-- Privacy Modal -->
<div class="modal fade" id="privacyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Política de Privacidade</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6>1. Recolha de Dados</h6>
                <p>Recolhemos informações pessoais necessárias para fornecer os nossos serviços.</p>
                
                <h6>2. Utilização de Dados</h6>
                <p>Os seus dados são utilizados para personalizar a sua experiência e comunicar eventos importantes.</p>
                
                <h6>3. Partilha de Dados</h6>
                <p>Não partilhamos os seus dados pessoais com terceiros sem o seu consentimento.</p>
                
                <h6>4. Segurança</h6>
                <p>Implementamos medidas de segurança para proteger as suas informações.</p>
                
                <h6>5. Direitos do Utilizador</h6>
                <p>Você tem o direito de aceder, corrigir ou eliminar os seus dados pessoais.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
function togglePassword(fieldId) {
    const passwordInput = document.getElementById(fieldId);
    const toggleIcon = document.getElementById(fieldId + 'Toggle');
    
    if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        toggleIcon.className = 'bi bi-eye-slash';
    } else {
        passwordInput.type = 'password';
        toggleIcon.className = 'bi bi-eye';
    }
}

// Password strength indicator
document.getElementById('password').addEventListener('input', function() {
    const password = this.value;
    const strength = checkPasswordStrength(password);
    updatePasswordStrength(strength);
});

function checkPasswordStrength(password) {
    let strength = 0;
    
    if (password.length >= 6) strength++;
    if (password.length >= 10) strength++;
    if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
    if (/\d/.test(password)) strength++;
    if (/[!@#$%^&*(),.?":{}|<>]/.test(password)) strength++;
    
    return strength;
}

function updatePasswordStrength(strength) {
    const strengthBar = document.getElementById('passwordStrength') || createPasswordStrengthBar();
    const colors = ['danger', 'warning', 'info', 'success'];
    const texts = ['Fraca', 'Média', 'Forte', 'Muito Forte'];
    
    strengthBar.className = `progress mb-2`;
    const bar = strengthBar.querySelector('.progress-bar');
    bar.className = `progress-bar bg-${colors[Math.min(strength - 1, 3)]}`;
    bar.style.width = `${(strength / 5) * 100}%`;
    
    const text = strengthBar.querySelector('.strength-text');
    text.textContent = strength > 0 ? texts[Math.min(strength - 1, 3)] : '';
}

function createPasswordStrengthBar() {
    const container = document.getElementById('password').closest('.mb-3');
    const strengthDiv = document.createElement('div');
    strengthDiv.id = 'passwordStrength';
    strengthDiv.className = 'progress mb-2';
    strengthDiv.innerHTML = `
        <div class="progress-bar" role="progressbar" style="width: 0%"></div>
        <small class="strength-text text-muted"></small>
    `;
    container.insertBefore(strengthDiv, container.querySelector('.input-group'));
    return strengthDiv;
}
</script>
<% } %>
