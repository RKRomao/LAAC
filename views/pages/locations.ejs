<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - LAAC</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-mortarboard-fill me-2"></i>LAAC
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/locations">Mapa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/events">Eventos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/faq">FAQ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/support">Suporte</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i><%= user.name %>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/profile">Perfil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/logout">Sair</a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Login</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container-fluid mt-4">
        <div class="row">
            <!-- Navigation Panel -->
            <div class="col-lg-4 col-md-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-geo-alt-fill me-2"></i>
                            Navegação UBI
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Location Selection -->
                        <div class="mb-4">
                            <label for="fromLocation" class="form-label">
                                <i class="bi bi-geo-alt me-1"></i> Partida
                            </label>
                            <div class="input-group">
                                <select class="form-select" id="fromLocation">
                                    <option value="">Escolher local de partida...</option>
                                    <option value="current-location">📍 Minha Localização Atual</option>
                                </select>
                                <button class="btn btn-outline-primary" type="button" id="getCurrentLocationBtn" title="Obter minha localização">
                                    <i class="bi bi-crosshair"></i>
                                </button>
                            </div>
                            <div class="form-text">Pode escolher um local específico ou usar sua localização atual como ponto de partida</div>
                        </div>
                        
                        <div class="mb-4">
                            <label for="toLocation" class="form-label">
                                <i class="bi bi-geo-alt me-1"></i> Destino
                            </label>
                            <select class="form-select" id="toLocation">
                                <option value="">Escolher local de destino...</option>
                            </select>
                        </div>
                        
                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 mb-4">
                            <button class="btn btn-primary" id="showRouteBtn" disabled>
                                <i class="bi bi-map me-2"></i>Mostrar no Mapa
                            </button>
                            <button class="btn btn-success" id="getDirectionsBtn" disabled>
                                <i class="bi bi-directions me-2"></i>Direções Google Maps
                            </button>
                        </div>
                        
                        <!-- Location Info -->
                        <div id="locationInfo" class="alert alert-info d-none">
                            <h6 class="alert-heading">Informações do Destino</h6>
                            <div id="locationDetails"></div>
                        </div>
                    </div>
                </div>
                
                <!-- Quick Locations -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0">
                            <i class="bi bi-building me-2"></i>
                            Locais Rápidos
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="list-group" id="quickLocations">
                            <!-- Will be populated by JavaScript -->
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Map Container -->
            <div class="col-lg-8 col-md-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-map-fill me-2"></i>
                            Mapa da Covilhã
                        </h5>
                        <div class="btn-group btn-group-sm" role="group">
                            <button class="btn btn-outline-light" id="resetMapBtn" title="Resetar Mapa">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <button class="btn btn-outline-light" id="locateMeBtn" title="Minha Localização">
                                <i class="bi bi-geo-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div id="map" style="height: 600px; width: 100%;"></div>
                    </div>
                </div>
                
                <!-- Map Legend -->
                <div class="card shadow-sm mt-3">
                    <div class="card-body">
                        <h6 class="card-title">Legenda</h6>
                        <div class="row">
                            <div class="col-6">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-primary rounded-circle me-2" style="width: 12px; height: 12px;"></span>
                                    <small>Educação</small>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-success rounded-circle me-2" style="width: 12px; height: 12px;"></span>
                                    <small>Saúde</small>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-info rounded-circle me-2" style="width: 12px; height: 12px;"></span>
                                    <small>Desporto</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-warning rounded-circle me-2" style="width: 12px; height: 12px;"></span>
                                    <small>Cultura</small>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-secondary rounded-circle me-2" style="width: 12px; height: 12px;"></span>
                                    <small>Alojamento</small>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-danger rounded-circle me-2" style="width: 12px; height: 12px;"></span>
                                    <small>Outros</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5><i class="bi bi-mortarboard-fill me-2"></i>LAAC</h5>
                    <p class="small">Liga de Apoio ao Académico da Covilhã</p>
                    <p class="small mb-0">
                        <i class="bi bi-envelope me-1"></i> laac@ubi.pt<br>
                        <i class="bi bi-telephone me-1"></i> +351 275 319 700
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h6>Links Úteis</h6>
                    <div class="d-flex flex-column align-items-md-end gap-2">
                        <a href="https://www.ubi.pt" target="_blank" class="text-white text-decoration-none small">
                            <i class="bi bi-globe me-1"></i> Universidade da Beira Interior
                        </a>
                        <a href="https://www.ubi.pt/Pagina/Faculdades" target="_blank" class="text-white text-decoration-none small">
                            <i class="bi bi-building me-1"></i> Faculdades UBI
                        </a>
                    </div>
                </div>
            </div>
            <hr class="bg-secondary">
            <div class="text-center">
                <p class="small mb-0">&copy; 2024 LAAC - Liga de Apoio ao Académico da Covilhã. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <script>
        // Global variables
        let map;
        let locations = [];
        let markers = [];
        let routeLine = null;
        let currentMarker = null;
        let userLocation = null;
        
        // Initialize map
        function initMap() {
            // Center map on Covilhã
            map = L.map('map').setView([40.2795, -7.5060], 14);
            
            // Add tile layer
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);
            
            // Load data
            loadLocations();
        }
        
        // Load locations from API
        async function loadLocations() {
            try {
                const response = await fetch('/api/locations?limit=100');
                const result = await response.json();
                locations = result.data || [];
                
                populateLocationSelects();
                populateQuickLocations();
                updateMap();
            } catch (error) {
                console.error('Error loading locations:', error);
                showAlert('Erro ao carregar locais', 'danger');
            }
        }
        
        // Populate location select dropdowns
        function populateLocationSelects() {
            const fromSelect = document.getElementById('fromLocation');
            const toSelect = document.getElementById('toLocation');
            
            // Clear existing options but preserve current location option
            const currentLocationOption = fromSelect.querySelector('option[value="current-location"]');
            
            fromSelect.innerHTML = '<option value="">Escolher local de partida...</option>';
            toSelect.innerHTML = '<option value="">Escolher local de destino...</option>';
            
            // Add current location option back if it existed
            if (currentLocationOption) {
                fromSelect.appendChild(currentLocationOption);
            } else {
                // Add current location option if not present
                const option = document.createElement('option');
                option.value = 'current-location';
                option.textContent = '?? Minha Localização Atual';
                fromSelect.appendChild(option);
            }
            
            // Add locations to both selects
            locations.forEach(location => {
                const option1 = document.createElement('option');
                option1.value = location.id;
                option1.textContent = location.name;
                fromSelect.appendChild(option1);
                
                const option2 = document.createElement('option');
                option2.value = location.id;
                option2.textContent = location.name;
                toSelect.appendChild(option2);
            });
        }
        
        // Populate quick locations list
        function populateQuickLocations() {
            const quickLocations = document.getElementById('quickLocations');
            quickLocations.innerHTML = '';
            
            // Group locations by category
            const categories = {};
            locations.forEach(location => {
                if (!categories[location.category]) {
                    categories[location.category] = [];
                }
                categories[location.category].push(location);
            });
            
            // Create quick location buttons
            Object.keys(categories).forEach(category => {
                const categoryDiv = document.createElement('div');
                categoryDiv.className = 'mb-3';
                categoryDiv.innerHTML = `<h6 class="text-muted small">${category}</h6>`;
                
                categories[category].forEach(location => {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-sm btn-outline-primary me-1 mb-1';
                    btn.textContent = location.name;
                    btn.onclick = () => selectQuickLocation(location.id);
                    categoryDiv.appendChild(btn);
                });
                
                quickLocations.appendChild(categoryDiv);
            });
        }
        
        // Select quick location
        function selectQuickLocation(locationId) {
            document.getElementById('toLocation').value = locationId;
            updateButtonStates();
            showLocationOnMap(locationId);
        }
        
        // Update map with markers
        function updateMap() {
            // Clear existing markers
            markers.forEach(marker => map.removeLayer(marker));
            markers = [];
            
            // Add markers for each location
            locations.forEach(location => {
                if (location.latitude && location.longitude) {
                    const marker = L.marker([location.latitude, location.longitude], {
                        icon: getCustomIcon(location.category)
                    }).addTo(map);
                    
                    // Create popup content
                    const popupContent = createPopupContent(location);
                    marker.bindPopup(popupContent);
                    
                    markers.push(marker);
                }
            });
            
            // Fit map to show all markers
            if (markers.length > 0) {
                const group = new L.featureGroup(markers);
                map.fitBounds(group.getBounds().pad(0.1));
            }
        }
        
        // Get custom icon based on category
        function getCustomIcon(category) {
            const colors = {
                'Educação': '#007bff',
                'Saúde': '#28a745',
                'Desporto': '#17a2b8',
                'Cultura': '#ffc107',
                'Alojamento': '#6c757d'
            };
            
            const color = colors[category] || '#dc3545';
            
            return L.divIcon({
                className: 'custom-marker',
                html: `<div style="background: ${color}; border: 2px solid white; border-radius: 50%; width: 12px; height: 12px;"></div>`,
                iconSize: [12, 12],
                iconAnchor: [6, 6]
            });
        }
        
        // Create popup content
        function createPopupContent(location) {
            return `
                <div style="min-width: 200px;">
                    <h6 class="mb-2">${location.name}</h6>
                    <p class="mb-2 small text-muted">${location.description || ''}</p>
                    <p class="mb-1 small"><i class="bi bi-geo-alt me-1"></i> ${location.address}</p>
                    ${location.openingHours ? `<p class="mb-1 small"><i class="bi bi-clock me-1"></i> ${location.openingHours}</p>` : ''}
                    ${location.website ? `<p class="mb-2 small"><i class="bi bi-globe me-1"></i> <a href="${location.website}" target="_blank">Website</a></p>` : ''}
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-primary" onclick="selectAsDestination('${location.id}')">
                            <i class="bi bi-geo-alt me-1"></i> Destino
                        </button>
                        <button class="btn btn-sm btn-success" onclick="getDirectionsTo('${location.id}')">
                            <i class="bi bi-directions me-1"></i> Direções
                        </button>
                    </div>
                </div>
            `;
        }
        
        // Select as destination
        function selectAsDestination(locationId) {
            document.getElementById('toLocation').value = locationId;
            updateButtonStates();
            showLocationOnMap(locationId);
        }
        
        // Get directions to location
        function getDirectionsTo(locationId) {
            const location = locations.find(loc => loc.id === locationId);
            if (location) {
                const url = `https://www.google.com/maps/dir/?api=1&destination=${location.latitude},${location.longitude}`;
                window.open(url, '_blank');
            }
        }
        
        // Show location on map
        function showLocationOnMap(locationId) {
            const location = locations.find(loc => loc.id === locationId);
            if (location && location.latitude && location.longitude) {
                // Clear current marker
                if (currentMarker) {
                    map.removeLayer(currentMarker);
                }
                
                // Add highlight marker
                currentMarker = L.marker([location.latitude, location.longitude], {
                    icon: L.divIcon({
                        className: 'highlight-marker',
                        html: '<div style="background: #ff0000; border: 3px solid white; border-radius: 50%; width: 16px; height: 16px; box-shadow: 0 0 10px rgba(255,0,0,0.5);"></div>',
                        iconSize: [16, 16],
                        iconAnchor: [8, 8]
                    })
                }).addTo(map);
                
                // Center map on location
                map.setView([location.latitude, location.longitude], 16);
                
                // Show location info
                showLocationInfo(location);
            }
        }
        
        // Show location information
        function showLocationInfo(location) {
            const infoDiv = document.getElementById('locationInfo');
            const detailsDiv = document.getElementById('locationDetails');
            
            detailsDiv.innerHTML = `
                <p class="mb-1"><strong>${location.name}</strong></p>
                <p class="mb-1 small">${location.address}</p>
                ${location.openingHours ? `<p class="mb-1 small"><i class="bi bi-clock me-1"></i> ${location.openingHours}</p>` : ''}
                ${location.description ? `<p class="mb-1 small">${location.description}</p>` : ''}
            `;
            
            infoDiv.classList.remove('d-none');
        }
        
        // Show route on map
        function showRoute() {
            const fromId = document.getElementById('fromLocation').value;
            const toId = document.getElementById('toLocation').value;
            
            if (!fromId || !toId) return;
            
            let fromLocation, fromCoords;
            
            // Handle current location
            if (fromId === 'current-location') {
                if (!userLocation) {
                    showAlert('Por favor, obtenha sua localização atual primeiro', 'warning');
                    return;
                }
                fromCoords = [userLocation.lat, userLocation.lng];
                fromLocation = { name: 'Minha Localização Atual', latitude: userLocation.lat, longitude: userLocation.lng };
            } else {
                fromLocation = locations.find(loc => loc.id === fromId);
                if (!fromLocation) return;
                fromCoords = [fromLocation.latitude, fromLocation.longitude];
            }
            
            const toLocation = locations.find(loc => loc.id === toId);
            if (!toLocation) return;
            
            // Clear existing route
            if (routeLine) {
                map.removeLayer(routeLine);
            }
            
            // Create route line
            const routeCoordinates = [
                fromCoords,
                [toLocation.latitude, toLocation.longitude]
            ];
            
            routeLine = L.polyline(routeCoordinates, {
                color: '#007bff',
                weight: 4,
                opacity: 0.7,
                dashArray: '10, 10'
            }).addTo(map);
            
            // Fit map to show route
            const bounds = L.latLngBounds(routeCoordinates);
            map.fitBounds(bounds.pad(0.1));
            
            // Show destination info
            showLocationInfo(toLocation);
        }
        
        // Get Google Maps directions
        function getDirections() {
            const fromId = document.getElementById('fromLocation').value;
            const toId = document.getElementById('toLocation').value;
            
            if (!fromId || !toId) {
                showAlert('Por favor, selecione ambos os locais', 'warning');
                return;
            }
            
            let fromLocation, toLocation;
            
            // Handle current location
            if (fromId === 'current-location') {
                if (!userLocation) {
                    showAlert('Por favor, obtenha sua localização atual primeiro', 'warning');
                    return;
                }
                fromLocation = { latitude: userLocation.lat, longitude: userLocation.lng };
            } else {
                fromLocation = locations.find(loc => loc.id === fromId);
                if (!fromLocation) {
                    showAlert('Local de partida não encontrado', 'danger');
                    return;
                }
            }
            
            toLocation = locations.find(loc => loc.id === toId);
            if (!toLocation) {
                showAlert('Local de destino não encontrado', 'danger');
                return;
            }
            
            const url = `https://www.google.com/maps/dir/?api=1&origin=${fromLocation.latitude},${fromLocation.longitude}&destination=${toLocation.latitude},${toLocation.longitude}`;
            window.open(url, '_blank');
        }
        
        // Update button states
        function updateButtonStates() {
            const fromValue = document.getElementById('fromLocation').value;
            const toValue = document.getElementById('toLocation').value;
            const showRouteBtn = document.getElementById('showRouteBtn');
            const getDirectionsBtn = document.getElementById('getDirectionsBtn');
            
            const hasBoth = fromValue && toValue;
            showRouteBtn.disabled = !hasBoth;
            getDirectionsBtn.disabled = !hasBoth;
        }
        
        // Get current location for departure
        function getCurrentLocation() {
            if (navigator.geolocation) {
                const btn = document.getElementById('getCurrentLocationBtn');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Obtendo...';
                
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        
                        userLocation = { lat, lng };
                        
                        // Update dropdown to show current location is available
                        const fromSelect = document.getElementById('fromLocation');
                        const currentOption = fromSelect.querySelector('option[value="current-location"]');
                        currentOption.textContent = `📍 Minha Localização (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
                        
                        // Auto-select current location
                        fromSelect.value = 'current-location';
                        
                        // Add user marker to map
                        if (currentMarker) {
                            map.removeLayer(currentMarker);
                        }
                        
                        currentMarker = L.marker([lat, lng], {
                            icon: L.divIcon({
                                className: 'user-marker',
                                html: '<div style="background: #28a745; border: 3px solid white; border-radius: 50%; width: 16px; height: 16px; box-shadow: 0 0 10px rgba(40,167,69,0.5);"></div>',
                                iconSize: [16, 16],
                                iconAnchor: [8, 8]
                            })
                        }).addTo(map);
                        
                        map.setView([lat, lng], 15);
                        updateButtonStates();
                        
                        showAlert('Localização atual obtida com sucesso!', 'success');
                        
                        // Reset button
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-crosshair"></i>';
                    },
                    (error) => {
                        showAlert('Não foi possível obter sua localização. Verifique as permissões do navegador.', 'warning');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-crosshair"></i>';
                    }
                );
            } else {
                showAlert('Geolocalização não suportada pelo navegador', 'warning');
            }
        }
        
        // Get user location (legacy function)
        function getUserLocation() {
            getCurrentLocation();
        }
        
        // Reset map
        function resetMap() {
            // Clear markers and routes
            if (currentMarker) {
                map.removeLayer(currentMarker);
                currentMarker = null;
            }
            
            if (routeLine) {
                map.removeLayer(routeLine);
                routeLine = null;
            }
            
            // Hide location info
            document.getElementById('locationInfo').classList.add('d-none');
            
            // Reset to show all locations
            updateMap();
        }
        
        // Show alert (helper function)
        function showAlert(message, type) {
            // Create alert element
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
            alertDiv.style.zIndex = '9999';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.appendChild(alertDiv);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.parentNode.removeChild(alertDiv);
                }
            }, 3000);
        }
        
        // Initialize everything
        document.addEventListener('DOMContentLoaded', function() {
            initMap();
            
            // Event listeners
            document.getElementById('fromLocation').addEventListener('change', function() {
                updateButtonStates();
                if (this.value && this.value !== 'current-location') {
                    showLocationOnMap(this.value);
                }
            });
            
            document.getElementById('toLocation').addEventListener('change', function() {
                updateButtonStates();
                if (this.value) {
                    showLocationOnMap(this.value);
                }
            });
            
            document.getElementById('getCurrentLocationBtn').addEventListener('click', getCurrentLocation);
            document.getElementById('showRouteBtn').addEventListener('click', showRoute);
            document.getElementById('getDirectionsBtn').addEventListener('click', getDirections);
            document.getElementById('resetMapBtn').addEventListener('click', resetMap);
            document.getElementById('locateMeBtn').addEventListener('click', getUserLocation);
        });
    </script>
</body>
</html>
