<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - LAAC</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-mortarboard-fill me-2"></i>LAAC
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house-fill me-1"></i> Início
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/faq">
                            <i class="bi bi-question-circle-fill me-1"></i> FAQ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/events">
                            <i class="bi bi-calendar-event-fill me-1"></i> Eventos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/support">
                            <i class="bi bi-headset me-1"></i> Suporte
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-4">
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg">
            <div class="card-body p-5">
                <!-- Logo Centralizado -->
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="bi bi-mortarboard-fill text-primary fs-1"></i>
                    </div>
                    <h3 class="mt-3">LAAC</h3>
                    <p class="text-muted">Plataforma de Apoio ao Caloiro</p>
                </div>

                <!-- Botões de Toggle -->
                <div class="btn-group d-flex mb-4" role="group">
                    <button type="button" id="loginToggle" class="btn btn-outline-primary flex-fill active">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                    </button>
                    <button type="button" id="registerToggle" class="btn btn-outline-primary flex-fill">
                        <i class="bi bi-person-plus me-2"></i>Registar
                    </button>
                </div>

                <!-- Formulário de Login -->
                <div id="loginForm" class="auth-form">
                    <form id="loginFormElement" class="needs-validation" novalidate action="/api/auth/login" method="POST">
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">
                                <i class="bi bi-envelope me-1"></i>Email
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" class="form-control" id="loginEmail" name="email" 
                                       placeholder="seu.email@exemplo.com" required>
                                <div class="invalid-feedback">
                                    Por favor, insira um email válido.
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">
                                <i class="bi bi-lock me-1"></i>Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" class="form-control" id="loginPassword" name="password" 
                                       placeholder="Insira a sua password" required>
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('loginPassword')">
                                    <i class="bi bi-eye" id="loginPasswordToggle"></i>
                                </button>
                                <div class="invalid-feedback">
                                    Por favor, insira a sua password.
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">
                                Lembrar-me
                            </label>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                            </button>
                        </div>

                        <div class="text-center">
                            <a href="/forgot-password" class="text-decoration-none">
                                <i class="bi bi-question-circle me-1"></i>Esqueceu a password?
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Formulário de Registo -->
                <div id="registerForm" class="auth-form" style="display: none;">
                    <form id="registerFormElement" class="needs-validation" novalidate action="/api/auth/register" method="POST">
                        <div class="mb-3">
                            <label for="registerName" class="form-label">
                                <i class="bi bi-person me-1"></i>Nome Completo
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input type="text" class="form-control" id="registerName" name="name" 
                                       placeholder="João Silva" required>
                                <div class="invalid-feedback">
                                    Por favor, insira o seu nome completo.
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="registerEmail" class="form-label">
                                <i class="bi bi-envelope me-1"></i>Email
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" class="form-control" id="registerEmail" name="email" 
                                       placeholder="seu.email@exemplo.com" required>
                                <div class="invalid-feedback">
                                    Por favor, insira um email válido.
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="registerPassword" class="form-label">
                                <i class="bi bi-lock me-1"></i>Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" class="form-control" id="registerPassword" name="password" 
                                       placeholder="Mínimo 6 caracteres" required minlength="6">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('registerPassword')">
                                    <i class="bi bi-eye" id="registerPasswordToggle"></i>
                                </button>
                                <div class="invalid-feedback">
                                    A password deve ter pelo menos 6 caracteres.
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">
                                <i class="bi bi-lock-fill me-1"></i>Confirmar Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" 
                                       placeholder="Confirme a password" required>
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword')">
                                    <i class="bi bi-eye" id="confirmPasswordToggle"></i>
                                </button>
                                <div class="invalid-feedback">
                                    Por favor, confirme a sua password.
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="role" class="form-label">
                                <i class="bi bi-person-badge me-1"></i>Tipo de Utilizador
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person-badge"></i>
                                </span>
                                <select class="form-select" id="role" name="role">
                                    <option value="">Selecione...</option>
                                    <option value="core_team">Membro da Equipa</option>
                                </select>
                            </div>
                            <small class="text-muted">
                                Selecione o tipo de utilizador que melhor descreve a sua situação.
                            </small>
                        </div>

                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="terms" required>
                                <label class="form-check-label" for="terms">
                                    Aceito os <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">termos de serviço</a> 
                                    e a <a href="#" data-bs-toggle="modal" data-bs-target="#privacyModal">política de privacidade</a>
                                </label>
                                <div class="invalid-feedback">
                                    É necessário aceitar os termos de serviço.
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="newsletter">
                                <label class="form-check-label" for="newsletter">
                                    Deseja receber novidades e eventos por email?
                                </label>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-person-plus me-2"></i>Criar Conta
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Social Login/Register -->
                <div class="text-center mt-4">
                    <p class="text-muted mb-3">Ou utilize:</p>
                    <div class="d-grid gap-2">
                        <a href="/api/auth/google" class="btn btn-outline-danger">
                            <i class="bi bi-google me-2"></i>Google
                        </a>
                        <a href="/api/auth/microsoft" class="btn btn-outline-primary">
                            <i class="bi bi-microsoft me-2"></i>Microsoft
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Terms Modal -->
<div class="modal fade" id="termsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Termos de Serviço</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6>1. Aceitação dos Termos</h6>
                <p>Ao criar uma conta na plataforma LAAC, você concorda com estes termos de serviço.</p>
                
                <h6>2. Uso da Plataforma</h6>
                <p>A plataforma LAAC destina-se a apoiar novos alunos na sua integração académica e social.</p>
                
                <h6>3. Responsabilidades do Utilizador</h6>
                <p>Os utilizadores devem manter a precisão das suas informações e comportar-se de forma respeitosa.</p>
                
                <h6>4. Privacidade e Dados</h6>
                <p>Os seus dados pessoais serão tratados de acordo com a nossa política de privacidade.</p>
                
                <h6>5. Modificações</h6>
                <p>Reservamo-nos o direito de modificar estes termos a qualquer momento.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<!-- Privacy Modal -->
<div class="modal fade" id="privacyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Política de Privacidade</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6>1. Recolha de Dados</h6>
                <p>Recolhemos informações pessoais necessárias para fornecer os nossos serviços.</p>
                
                <h6>2. Utilização de Dados</h6>
                <p>Os seus dados são utilizados para personalizar a sua experiência e comunicar eventos importantes.</p>
                
                <h6>3. Partilha de Dados</h6>
                <p>Não partilhamos os seus dados pessoais com terceiros sem o seu consentimento.</p>
                
                <h6>4. Segurança</h6>
                <p>Implementamos medidas de segurança para proteger as suas informações.</p>
                
                <h6>5. Direitos do Utilizador</h6>
                <p>Você tem o direito de aceder, corrigir ou eliminar os seus dados pessoais.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
// Toggle entre formulários
function showLoginForm() {
    document.getElementById('loginForm').style.display = 'block';
    document.getElementById('registerForm').style.display = 'none';
    document.getElementById('loginToggle').classList.add('active');
    document.getElementById('registerToggle').classList.remove('active');
}

function showRegisterForm() {
    document.getElementById('loginForm').style.display = 'none';
    document.getElementById('registerForm').style.display = 'block';
    document.getElementById('loginToggle').classList.remove('active');
    document.getElementById('registerToggle').classList.add('active');
}

// Adicionar event listeners quando o DOM estiver carregado
document.addEventListener('DOMContentLoaded', function() {
    const loginToggle = document.getElementById('loginToggle');
    const registerToggle = document.getElementById('registerToggle');
    
    if (loginToggle) {
        loginToggle.addEventListener('click', showLoginForm);
    }
    
    if (registerToggle) {
        registerToggle.addEventListener('click', showRegisterForm);
    }
});

// Toggle password visibility
function togglePassword(fieldId) {
    const passwordInput = document.getElementById(fieldId);
    const toggleIcon = document.getElementById(fieldId + 'Toggle');
    
    if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        toggleIcon.className = 'bi bi-eye-slash';
    } else {
        passwordInput.type = 'password';
        toggleIcon.className = 'bi bi-eye';
    }
}


// Password strength indicator for registration
document.getElementById('registerPassword')?.addEventListener('input', function() {
    const password = this.value;
    const strength = checkPasswordStrength(password);
    updatePasswordStrength(strength);
});

function checkPasswordStrength(password) {
    let strength = 0;
    
    if (password.length >= 6) strength++;
    if (password.length >= 10) strength++;
    if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
    if (/\d/.test(password)) strength++;
    if (/[!@#$%^&*(),.?":{}|<>]/.test(password)) strength++;
    
    return strength;
}

function updatePasswordStrength(strength) {
    const strengthBar = document.getElementById('passwordStrength') || createPasswordStrengthBar();
    const colors = ['danger', 'warning', 'info', 'success'];
    const texts = ['Fraca', 'Média', 'Forte', 'Muito Forte'];
    
    strengthBar.className = `progress mb-2`;
    const bar = strengthBar.querySelector('.progress-bar');
    bar.className = `progress-bar bg-${colors[Math.min(strength - 1, 3)]}`;
    bar.style.width = `${(strength / 5) * 100}%`;
    
    const text = strengthBar.querySelector('.strength-text');
    text.textContent = strength > 0 ? texts[Math.min(strength - 1, 3)] : '';
}

function createPasswordStrengthBar() {
    const container = document.getElementById('registerPassword').closest('.mb-3');
    const strengthDiv = document.createElement('div');
    strengthDiv.id = 'passwordStrength';
    strengthDiv.className = 'progress mb-2';
    strengthDiv.innerHTML = `
        <div class="progress-bar" role="progressbar" style="width: 0%"></div>
        <small class="strength-text text-muted"></small>
    `;
    container.insertBefore(strengthDiv, container.querySelector('.input-group'));
    return strengthDiv;
}

// Form validation and submission
document.getElementById('loginFormElement')?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    if (!this.checkValidity()) {
        e.stopPropagation();
        this.classList.add('was-validated');
        return;
    }
    
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);
    
    fetch('/api/auth/login', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
    })
    .then(function(response) {
        if (response.ok) {
            return response.json();
        } else {
            return response.json().then(function(error) {
                throw new Error(error.message || 'Erro ao fazer login. Tente novamente.');
            });
        }
    })
    .then(function(result) {
        // Redirecionar para a página principal ou dashboard
        window.location.href = '/';
    })
    .catch(function(error) {
        console.error('Login error:', error);
        alert(error.message || 'Erro de conexão. Tente novamente.');
    });
});

document.getElementById('registerFormElement')?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const password = document.getElementById('registerPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    
    if (password !== confirmPassword) {
        alert('As passwords não coincidem!');
        return;
    }
    
    if (!this.checkValidity()) {
        e.stopPropagation();
        this.classList.add('was-validated');
        return;
    }
    
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);
    
    fetch('/api/auth/register', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
    })
    .then(function(response) {
        if (response.ok) {
            return response.json();
        } else {
            return response.json().then(function(error) {
                throw new Error(error.message || 'Erro ao fazer registo. Tente novamente.');
            });
        }
    })
    .then(function(result) {
        alert('Registo realizado com sucesso! Por favor, faça login.');
        // Mudar para o formulário de login
        showLoginForm();
        // Limpar formulário de registo
        document.getElementById('registerFormElement').reset();
        document.getElementById('registerFormElement').classList.remove('was-validated');
    })
    .catch(function(error) {
        console.error('Register error:', error);
        alert(error.message || 'Erro de conexão. Tente novamente.');
    });
});
</script>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5 py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="bi bi-mortarboard-fill me-2"></i>LAAC</h5>
                    <p class="text-muted">Liga de Apoio ao Académico da Covilhã</p>
                    <p class="small">Ajudando novos alunos a integrar-se na vida académica e na cidade da Covilhã.</p>
                </div>
                <div class="col-md-4">
                    <h5>Links Úteis</h5>
                    <ul class="list-unstyled">
                        <li><a href="/faq" class="text-light text-decoration-none">FAQ</a></li>
                        <li><a href="/events" class="text-light text-decoration-none">Eventos</a></li>
                        <li><a href="/support" class="text-light text-decoration-none">Suporte</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Contacto</h5>
                    <p class="text-light">
                        <i class="bi bi-envelope me-2"></i>contacto@laac.pt<br>
                        <i class="bi bi-telephone me-2"></i>+351 123 456 789
                    </p>
                </div>
            </div>
            <hr class="bg-secondary">
            <div class="text-center">
                <p class="small mb-0">&copy; 2024 LAAC - Liga de Apoio ao Académico da Covilhã. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/main.js"></script>
</body>
</html>
